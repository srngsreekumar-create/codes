# Load required libraries
library(ggplot2)
library(tseries)
library(forecast)
library(dplyr)
library(gridExtra)

# Download US GDP data from FRED
gdp_url <- "https://fred.stlouisfed.org/graph/fredgraph.csv?id=GDP"

# Read CSV data
gdp_raw <- read.csv(
  gdp_url,
  stringsAsFactors = FALSE
)

# Rename columns
names(gdp_raw) <- c("date", "GDP")

# Convert columns to appropriate data types
gdp_raw$date <- as.Date(gdp_raw$date)
gdp_raw$GDP <- as.numeric(gdp_raw$GDP)

# Filter data from 2000 to 2023
gdp_df <- gdp_raw %>%
  filter(
    date >= as.Date("2000-01-01"),
    date <= as.Date("2023-12-31")
  ) %>%
  na.omit()

# Display the filtered dataset
head(gdp_df)

p1 <- ggplot(
  gdp_df,
  aes(x = date, y = GDP)
) +
  geom_line(color = "darkblue", size = 1) +
  labs(
    title = "US GDP (Level)",
    subtitle = "Non-stationary",
    x = "Date",
    y = "GDP"
  ) +
  theme_minimal() +
  theme(
    plot.title = element_text(
      hjust = 0.5,
      face = "bold"
    ),
    plot.subtitle = element_text(hjust = 0.5)
  )

# Display the plot
p1

# Calculate GDP growth rate
gdp_growth_df <- gdp_df %>%
  arrange(date) %>%
  mutate(
    growth = 100 * (GDP / lag(GDP) - 1)
  ) %>%
  na.omit()

# Plot GDP growth rate
p2 <- ggplot(
  gdp_growth_df,
  aes(x = date, y = growth)
) +
  geom_line(color = "darkgreen", size = 1) +
  geom_hline(
    yintercept = 0,
    color = "red",
    linetype = "dashed"
  ) +
  labs(
    title = "US GDP Growth Rate",
    subtitle = "Quarter-over-quarter percentage growth",
    x = "Date",
    y = "Growth (%)"
  ) +
  theme_minimal() +
  theme(
    plot.title = element_text(
      hjust = 0.5,
      face = "bold"
    ),
    plot.subtitle = element_text(hjust = 0.5)
  )

# Display the plot
p2

# Convert GDP values into a quarterly time series
gdp_ts <- ts(
  gdp_df$GDP,
  start = c(
    as.integer(format(gdp_df$date[1], "%Y")),
    (as.integer(format(gdp_df$date[1], "%m")) - 1) %/% 3 + 1
  ),
  frequency = 4
)

# ADF test on original GDP
adf.test(gdp_ts)

# ADF test on GDP growth
adf.test(gdp_growth_df$growth)

# First difference of GDP
diff_gdp <- diff(gdp_ts)

# Plot differenced GDP
plot(
  diff_gdp,
  main = "First Difference of US GDP",
  xlab = "Time",
  ylab = "Difference in GDP"
)

# ADF test on differenced GDP
adf.test(diff_gdp)

# Second difference of GDP
diff2_gdp <- diff(diff_gdp)

# Plot second-differenced GDP
plot(
  diff2_gdp,
  main = "Second Difference of US GDP",
  xlab = "Time",
  ylab = "Second Difference"
)

# ADF test on second-differenced GDP
adf.test(diff2_gdp)


