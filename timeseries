# Stationarity Differencing and Augmented Dickey-Fuller Test

# Read the monthly births dataset
births <- scan(
  "https://robjhyndman.com/tsdldata/data/nybirths.dat"
)

# Display the data
births

# Convert the data into a time series
births_TS <- ts(
  births,
  frequency = 12,
  start = c(1946, 1)
)

# Display the time series
births_TS

# Plot monthly births in New York City (1946-1959)
plot.ts(
  births_TS,
  main = "Monthly Births in New York City (1946-1959)",
  xlab = "Time",
  ylab = "Number of Births"
)

